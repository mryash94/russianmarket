# ====================================================================
# RUSSIAN MARKET — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit .env or .env.local to version control!
# ====================================================================

# --------------------------------------------------------------------
# Supabase Configuration (Client-safe Public Anon Key)
# --------------------------------------------------------------------
# Found in your Supabase Dashboard -> Project Settings -> API
# CAUTION: ONLY provide the public anon key. NEVER use the service-role key!
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key-placeholder

# --------------------------------------------------------------------
# SunPay Payment Gateway (Client-safe Parameters)
# --------------------------------------------------------------------
# Private webhook secrets and merchant signing keys must ONLY be stored
# on backend servers or Supabase Edge Functions, NEVER in frontend code.
VITE_SUNPAY_MERCHANT_ID=your-merchant-id-placeholder
VITE_SUNPAY_API_ENDPOINT=https://api.sunpay.gateway/v1
VITE_SUNPAY_SANDBOX_MODE=true

# --------------------------------------------------------------------
# Application Parameters
# --------------------------------------------------------------------
VITE_APP_NAME="RUSSIAN MARKET"
VITE_APP_CURRENCY="INR"
