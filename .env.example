# ====================================================================
# RUSSIAN MARKET ENVIRONMENT VARIABLES (.env.local)
# ====================================================================

# Public Supabase Configuration
# The Anon Key is safe for client-side usage; NEVER put service-role keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Future SunPay Gateway Integration Parameters (Optional)
# Keep backend secrets in server-side environment variables or Supabase Edge Functions.
VITE_SUNPAY_MERCHANT_ID=
VITE_SUNPAY_API_ENDPOINT=https://api.sunpay.gateway/v1
VITE_SUNPAY_SANDBOX_MODE=true
